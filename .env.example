# IFDY companion configuration (all optional).
# The studio works without these; features that need them are labelled as unavailable.

# Port for the studio (dev uses Vite's port; production uses this).
IFDY_PORT=4310
# Port for the isolated preview origin. Defaults to studio port + 1.
# IFDY_PREVIEW_PORT=4311
# Public base URL for the preview origin when running behind port forwarding.
# IFDY_PREVIEW_ORIGIN=https://preview.example.test

# AI debugging assistant. The key stays on the server and is never sent to the browser.
# ANTHROPIC_API_KEY=
# Model id for the hosted provider (required with ANTHROPIC_API_KEY).
# IFDY_AI_MODEL=
# Optional local OpenAI-compatible endpoint (e.g. Ollama, LM Studio). Must be explicitly configured.
# IFDY_LOCAL_AI_URL=http://127.0.0.1:11434/v1
# IFDY_LOCAL_AI_MODEL=llama3.1

# Local project companion: directories the studio may read/write (comma separated, absolute).
# Nothing outside these roots can be accessed. Leave empty to disable filesystem access.
# IFDY_ALLOWED_ROOTS=/Users/me/code/my-app

# Controlled browser (Playwright Chromium). Set to 0 to disable.
# IFDY_BROWSER=1
# IFDY_CHROMIUM_PATH=
