{
  "name": "ifdy",
  "displayName": "IFDY — Interface Foundry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Unified visual design IDE, browser DevTools, foldable device simulator and AI-assisted QA platform.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/start.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "browsers:install": "playwright install chromium"
  },
